# Copie para .env (nunca commitar o .env). Repositorio PUBLICO: este arquivo so tem placeholders.
# `make setup` faz a copia automaticamente.

# Django
# Local: DJANGO_DEBUG=true dispensa a SECRET_KEY. Em qualquer outro ambiente: false + chave longa.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco. Opcao A (local): `docker compose up -d` usa o compose.yaml deste repositorio.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/radar_dev
# Opcao B (Supabase radar-dev): string do POOLER em modo sessao (IPv4), NAO a conexao direta:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# Schema dedicado, nao exposto pela Data API do Supabase (ADR-016). Vazio = schema padrao.
DB_SCHEMA=radar
DB_CONN_MAX_AGE=0

# Identificacao do robo de coleta (User-Agent) e destinatario do digest
CONTACT_EMAIL=
DIGEST_TO=
# Dias de retenção do texto dos documentos coletados (purge_raw_documents)
RAW_DOCUMENT_RETENTION_DAYS=180

# Empresa (dados sensiveis: so aqui/banco, nunca no git)
COMPANY_CNPJ=

# IA (ADR-011). Orcamento de dinheiro novo por mes, em USD
LLM_MONTHLY_BUDGET_USD=5
# Creditos do Google AI Pro (Gemini pago), contados a parte do dinheiro novo
LLM_CREDITS_MONTHLY_USD=10
# Teto de gasto por execucao (soma creditos + dinheiro novo)
LLM_RUN_BUDGET_USD=1
# Free tier (AI Studio): so dados publicos. Pago: projeto com faturamento/creditos
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
ANTHROPIC_API_KEY=
# Ollama (opcional): local por padrao; servidor remoto so recebe dados publicos
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# Estrategias por tarefa em JSON (opcional): {"tarefa": ["provedor:modelo", "rules"]}
LLM_TASK_STRATEGIES={}

# Busca web (escolher um)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=
# Teto de buscas pagas por execucao de find_websites (consultas em cache nao contam)
SEARCH_MAX_CALLS_PER_RUN=100

# Digest semanal (E15): links do admin e envio opcional, SO para a lista abaixo (e-mails da equipe, separados por virgula)
DIGEST_BASE_URL=http://127.0.0.1:8000
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backup criptografado (chave PUBLICA age; a privada fica so com o titular)
BACKUP_AGE_PUBLIC_KEY=

# Logs: nunca imprimir dados pessoais (logs do GitHub Actions sao publicos)
LOG_PII=false
LOG_LEVEL=INFO
