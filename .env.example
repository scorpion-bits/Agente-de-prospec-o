# Copie para .env (nunca commitar o .env). Repositorio PUBLICO: este arquivo so tem placeholders.
# `make setup` faz a copia automaticamente.

# Django
# Local: DJANGO_DEBUG=true dispensa a SECRET_KEY. Em qualquer outro ambiente: false + chave longa.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco. Opcao A (local): `docker compose up -d` usa o compose.yaml deste repositorio.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/radar_dev
# Opcao B (Supabase radar-dev): string do POOLER em modo sessao (IPv4), NAO a conexao direta:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# Schema dedicado, nao exposto pela Data API do Supabase (ADR-016). Vazio = schema padrao.
DB_SCHEMA=radar
DB_CONN_MAX_AGE=0

# Identificacao do robo de coleta (User-Agent) e destinatario do digest
CONTACT_EMAIL=
DIGEST_TO=

# Empresa (dados sensiveis: so aqui/banco, nunca no git)
COMPANY_CNPJ=

# IA (ADR-011). Orcamento de dinheiro novo por mes, em USD
LLM_MONTHLY_BUDGET_USD=5
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
ANTHROPIC_API_KEY=

# Busca web (escolher um)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# Envio do digest para a propria equipe (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backup criptografado (chave PUBLICA age; a privada fica so com o titular)
BACKUP_AGE_PUBLIC_KEY=

# Logs: nunca imprimir dados pessoais (logs do GitHub Actions sao publicos)
LOG_PII=false
LOG_LEVEL=INFO
