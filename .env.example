# Copie para .env (nunca commitar o .env). Repositorio PUBLICO: este arquivo so tem placeholders.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: Supabase via POOLER (nao a conexao direta, que e IPv6). Um projeto por ambiente.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# Identificacao do robo de coleta (User-Agent) e destinatario do digest
CONTACT_EMAIL=
DIGEST_TO=

# Empresa (dados sensiveis: so aqui/banco, nunca no git)
COMPANY_CNPJ=

# IA (ADR-011). Orcamento de dinheiro novo por mes, em USD
LLM_MONTHLY_BUDGET_USD=5
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
ANTHROPIC_API_KEY=

# Busca web (escolher um)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# Envio do digest para a propria equipe (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backup criptografado (chave PUBLICA age; a privada fica so com o titular)
BACKUP_AGE_PUBLIC_KEY=

# Logs: nunca imprimir dados pessoais (logs do GitHub Actions sao publicos)
LOG_PII=false
